# Perpustakaan Metland School - Environment Configuration
# Salin file ini menjadi .env di server/ZimaOS Anda

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
AUTH_TRUST_HOST=true

# NextAuth Configuration
# Generate 32+ char secret: openssl rand -base64 32
NEXTAUTH_SECRET=metland_school_secret_key_demo_2026_super_secure_32char
NEXTAUTH_URL=http://localhost:3000

# PostgreSQL Connection String
# Contoh koneksi ke host ZimaOS: postgresql://postgres:password@host.docker.internal:5432/school_library?schema=public
# Contoh koneksi ke IP server: postgresql://postgres:password@192.168.1.50:5432/school_library?schema=public
DATABASE_URL=postgresql://username:password@host.docker.internal:5432/school_library?schema=public

# Demo Mode Settings (Set 'false' jika ingin menonaktifkan tombol demo)
ENABLE_DEMO_LOGIN=true
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=true

# Jina AI Vector Embeddings API (Untuk AI Semantic Search katalog buku)
# Ganti dengan endpoint Jina server sendiri
JINA_API_URL=https://jina-anda.domain.com/v1/embeddings
JINA_API_KEY=your_jina_api_key_here
JINA_EMBEDDING_MODEL=jina-embeddings-v5-text-small

# Jina Reranker v3 / v3.5 API
JINA_RERANKER_URL=https://reranker-anda.domain.com/v1/rerank
JINA_RERANKER_MODEL=jina-reranker-v3

# LLM Configuration (Untuk Query Transformation / Intent Extraction - Mendukung Ollama / llama.cpp GPU / OpenAI API)
OLLAMA_URL=https://qwen-anda.domain.com
OLLAMA_MODEL=/models/Qwen3-1.7B-UD-Q6_K_XL.gguf
OLLAMA_API_KEY=your_llm_api_key_here
OLLAMA_TIMEOUT_MS=2500
ENABLE_LLM_TRANSFORM=true

# Reranker Performance Control
# Set 'false' jika server reranker menggunakan CPU untuk menjaga latensi <300ms.
# Set 'true' jika server reranker memiliki akselerasi GPU.
ENABLE_RERANKER=true
JINA_RERANKER_TIMEOUT_MS=2500
