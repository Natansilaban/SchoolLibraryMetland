# Perpustakaan Metland School - Environment Configuration
# Salin file ini menjadi .env di environment lokal atau set melalui container runtime

# NextAuth Configuration
# Generate 32+ char secret: openssl rand -base64 32
NEXTAUTH_SECRET=your_32_character_random_secret_here
NEXTAUTH_URL=http://localhost:3000

# PostgreSQL Connection String
# Format: postgresql://[user]:[password]@[host]:[port]/[database_name]?schema=public
DATABASE_URL=postgresql://username:password@localhost:5432/school_library?schema=public

# Optional: Set to 'false' in production to disable 1-click quick demo buttons on login page
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=true
