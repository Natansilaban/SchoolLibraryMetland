# ===================================================
# School Library System - Environment Variables Template
# (For Education and Testing Purposes Only)
# ===================================================

# 1. Database Configuration (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database_name]?schema=public
# Local example: postgresql://postgres:postgres@localhost:5432/school_library?schema=public
# Docker example: postgresql://postgres:mypassword@db:5432/school_library?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_library?schema=public"

# 2. NextAuth Configuration
# Public application URL (without trailing slash)
# Local: http://localhost:3000
# Production: https://library.yourdomain.com
NEXTAUTH_URL="http://localhost:3000"

# Secret key for session encryption (at least 32 characters)
# Generate a secure random string using: openssl rand -base64 32
NEXTAUTH_SECRET="change-this-to-a-secure-random-secret-key-at-least-32-chars"
