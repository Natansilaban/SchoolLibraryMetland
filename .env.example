# Perpustakaan Metland School - Environment Configuration
# Salin file ini menjadi .env di server/ZimaOS Anda

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
AUTH_TRUST_HOST=true

# NextAuth Configuration
# Generate 32+ char secret: openssl rand -base64 32
NEXTAUTH_SECRET=metland_school_secret_key_demo_2026_super_secure_32char
NEXTAUTH_URL=http://localhost:3000

# PostgreSQL Connection String
# Contoh koneksi ke host ZimaOS: postgresql://postgres:password@host.docker.internal:5432/school_library?schema=public
# Contoh koneksi ke IP server: postgresql://postgres:password@192.168.1.50:5432/school_library?schema=public
DATABASE_URL=postgresql://username:password@host.docker.internal:5432/school_library?schema=public

# Demo Mode Settings (Set 'false' jika ingin menonaktifkan tombol demo)
ENABLE_DEMO_LOGIN=true
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=true

# Google Gemini API Key (Opsional - Untuk AI Semantic Search katalog buku)
# Dapatkan gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
