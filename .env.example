# ===================================================
# School Library System - Environment Variables
# ===================================================

# 1. Database Configuration (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database_name]?schema=public
# Contoh lokal: postgresql://postgres:postgres@localhost:5432/school_library?schema=public
# Contoh Docker: postgresql://postgres:mypassword@db:5432/school_library
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_library?schema=public"

# 2. NextAuth Configuration
# URL publik aplikasi (tanpa trailing slash)
# Lokal      : http://localhost:3000
# Production : https://perpus.sekolah.sch.id
NEXTAUTH_URL="http://localhost:3000"

# Rahasia enkripsi session token (minimal 32 karakter)
# Generate string acak dengan perintah: openssl rand -base64 32
NEXTAUTH_SECRET="change-this-to-a-secure-random-secret-key-at-least-32-chars"
